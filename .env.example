PORT=3001
DATABASE_URL=                   # Supabase → Connect → Direct → Transaction pooler (port 6543); put your DB password in it
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=          # Should: only needed for push webhooks
ANTHROPIC_API_KEY=
SMALL_MODEL=claude-haiku-5-5
BIG_MODEL=claude-sonnet-5-5
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=                 # for registering the /link command
DISCORD_GUILD_ID=               # the team's server
DISCORD_GROUP_CHANNEL_ID=
DISCORD_PUBLIC_KEY=             # Developer Portal → General Information; verifies /api/discord/interactions
CRON_SECRET=                    # random string; Supabase pg_cron sends it to /api/cron/*
DEMO_PRESENTER_KEY=             # /demo?key=<this> on the presenter's laptop turns Discord messages on for the public demo
TZ=America/Toronto              # set explicitly in Vercel too; check-ins and demo dates use this timezone
DISABLE_SCHEDULER=false         # true = no automatic check-ins (tests, rehearsals)
LLM_CACHE=off                   # fallback = save answers and reuse them if the API fails (demo); replay = saved answers only
SUPABASE_URL=                   # sign-in (#62): https://<project>.supabase.co (empty = no sign-in)
SUPABASE_PUBLISHABLE_KEY=       # sb_publishable_... (safe for the browser)
VITE_SUPABASE_URL=              # same two values, for the web app
VITE_SUPABASE_PUBLISHABLE_KEY=
AUTH_DISABLED=false             # true = keep the "Who are you?" picker (local demo only, never in production)
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api # Vercel: /api (same-origin deployed backend)
VITE_USE_MOCKS=true             # Vercel: false (use the real API, not browser fixtures)
