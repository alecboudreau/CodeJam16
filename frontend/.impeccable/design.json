  "narrative": {
    "northStar": "The Composed Project Steward",
    "overview": "A composed project steward keeps commitments visible. Warm ivory surroundings and parchment working surfaces make a practical, information-rich workspace feel calm. Umber actions and restrained outlines provide clear hierarchy without theatrical effects.\n\nThe Enforcer supplies the warmth: a watchful charcoal rook in a green chore jacket, with an ochre beak and clipboard. His appearances accompany guidance, onboarding, feedback and progress rather than becoming decoration on every control. Public Sans keeps the interface precise and approachable.",
    "keyCharacteristics": [
      "Calm ivory and tobacco surfaces and umber actions.",
      "Compact, readable working density.",
      "Restrained corners and outlined SVG icons.",
      "A firm, friendly character used at meaningful moments."
    ],
    "rules": [
      {
        "name": "The Umber Action Rule",
        "body": "Use umber for primary actions, the active navigation item and progress; reserve ochre and clay for attention and errors.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Separate working regions through pale tone, whitespace and fine borders; do not add decorative elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep actions legible against pale working surfaces.",
      "Do use the supplied Enforcer artwork with its natural proportions.",
      "Do preserve text labels, keyboard focus, reduced motion and the mobile reading order.",
      "Do pair status color with explicit status text."
    ],
    "donts": [
      "Don't substitute emoji or font glyphs for the outlined SVG icon system.",
      "Don't enlarge the mascot until it competes with the task or evidence being reviewed.",
      "Don't introduce glossy effects or decorative shadows into the flat working surfaces."
    ]
  }
}
